# Copia este archivo como .env y llena los valores reales
PORT=3000
# Número de WhatsApp con indicativo, solo dígitos. Permite que el pedido llegue escrito.
WHATSAPP=
# Si no hay número, se usa este enlace (no permite mensaje prellenado)
WHATSAPP_LINK=https://wa.me/message/FEN6KCIAPELQD1
INSTAGRAM=https://www.instagram.com/atlantatecnologia1_79/
# Dirección pública con https, para robots.txt y sitemap.xml
SITE_URL=
# Contacto para reportar fallas de seguridad (activa /.well-known/security.txt), ej. mailto:correo@dominio.com
CONTACTO_SEGURIDAD=
# Firma de las sesiones del panel (mínimo 32 caracteres). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Carpeta de datos que sobrevive a los despliegues (catálogo, usuarios, solicitudes, respaldos)
DATA_DIR=
